<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>PortMaster Candidate Scout</title>
    <link href="https://cdn.datatables.net/1.10.24/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/colreorder/1.5.3/css/colReorder.dataTables.min.css" rel="stylesheet">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/1.5.3/js/dataTables.colReorder.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/dataTables.bootstrap4.min.js"></script>
    <style>
        .badge-new { background-color: #28a745; color: #fff; }
        .badge-rising { background-color: #fd7e14; color: #fff; }
        .reason-cell { max-width: 320px; font-size: 0.9em; color: #555; }
        .card-repo { margin-bottom: 1rem; }
    </style>
</head>
<body>
    <div class="container py-5">
        <h1 class="mb-2">PortMaster Candidate Scout</h1>
        <p class="text-muted">Run: {{ run_date }}</p>

        <div class="row mb-4">
            <div class="col">
                <span class="badge badge-secondary mr-2">{{ summary.new_count }} new</span>
                <span class="badge badge-secondary mr-2">{{ summary.rising_count }} rising</span>
                <span class="badge badge-secondary mr-2">{{ summary.tracked_relevant_count }} tracked</span>
                <span class="badge badge-secondary mr-2">{{ summary.pending_count }} awaiting classification</span>
                <span class="badge badge-secondary">{{ summary.excluded_count }} excluded as noise</span>
            </div>
        </div>

        <h2 class="mb-3">New this week</h2>
        {% if new %}
        <div class="row">
            {% for repo in new %}
            <div class="col-md-6 card-repo">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge badge-new mb-2">NEW</span>
                        {% if repo.category %}<span class="badge badge-info mb-2">{{ repo.category }}</span>{% endif %}
                        <h5 class="card-title"><a href="{{ repo.url }}">{{ repo.full_name }}</a></h5>
                        <p class="card-text">{{ repo.description }}</p>
                        <p class="card-text reason-cell">{{ repo.reason }}</p>
                        <p class="card-text">
                            <small class="text-muted">
                                {{ repo.stars }}★ &middot; {{ repo.primary_language or "?" }}
                                &middot; created {{ repo.created_at }}
                                {% if repo.confidence is not none %}&middot; confidence {{ "%.2f"|format(repo.confidence) }}{% endif %}
                            </small>
                        </p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="text-muted">No new candidates this week.</p>
        {% endif %}

        <h2 class="mb-3 mt-5">Rising this week</h2>
        {% if rising %}
        <div class="row">
            {% for repo in rising %}
            <div class="col-md-6 card-repo">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge badge-rising mb-2">RISING (+{{ repo.star_delta }}★)</span>
                        {% if repo.category %}<span class="badge badge-info mb-2">{{ repo.category }}</span>{% endif %}
                        <h5 class="card-title"><a href="{{ repo.url }}">{{ repo.full_name }}</a></h5>
                        <p class="card-text">{{ repo.description }}</p>
                        <p class="card-text reason-cell">{{ repo.reason }}</p>
                        <p class="card-text">
                            <small class="text-muted">
                                {{ repo.stars }}★ ({% if repo.growth_pct is not none %}+{{ repo.growth_pct }}%{% endif %})
                                &middot; last push {{ repo.pushed_at }}
                            </small>
                        </p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="text-muted">Nothing crossed the growth threshold this week.</p>
        {% endif %}

        <h2 class="mb-3 mt-5">Full watchlist</h2>
        <table id="archive" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Stars</th>
                    <th>Category</th>
                    <th>Confidence</th>
                    <th>Language</th>
                    <th>First seen</th>
                    <th>Last rising</th>
                    <th>Description</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                {% for repo in archive %}
                <tr>
                    <td><a href="{{ repo.url }}">{{ repo.full_name }}</a></td>
                    <td>{{ repo.stars }}</td>
                    <td>{{ repo.category }}</td>
                    <td>{{ "%.2f"|format(repo.confidence) if repo.confidence is not none else "" }}</td>
                    <td>{{ repo.primary_language or "" }}</td>
                    <td>{{ repo.first_seen }}</td>
                    <td>{{ repo.last_rising_reported_at or "" }}</td>
                    <td>{{ repo.description }}</td>
                    <td class="reason-cell">{{ repo.reason }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="mt-5">
            <a data-toggle="collapse" href="#excluded" role="button" aria-expanded="false" aria-controls="excluded">
                Show {{ summary.excluded_count }} excluded-as-noise repos (classifier audit)
            </a>
        </p>
        <div class="collapse" id="excluded">
            <table id="excludedTable" class="table table-sm table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Stars</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    {% for repo in excluded %}
                    <tr>
                        <td><a href="{{ repo.url }}">{{ repo.full_name }}</a></td>
                        <td>{{ repo.stars }}</td>
                        <td class="reason-cell">{{ repo.reason }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <script>
        $(document).ready(function() {
            $('#archive').DataTable({
                colReorder: true,
                "pageLength": 50,
                "order": [[ 1, "desc" ]]
            });
            $('#excludedTable').DataTable({
                "pageLength": 25,
                "order": [[ 1, "desc" ]]
            });
        });
    </script>
</body>
</html>
